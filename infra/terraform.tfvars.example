# ============================================================
# terraform.tfvars.example
# ============================================================
# 이 파일을 복사해서 terraform.tfvars 로 이름 바꾸고
# 실제 값을 입력하세요.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# ⚠️  terraform.tfvars는 절대 Git에 올리지 마세요!
# ============================================================

aws_region   = "ap-northeast-2"
project_name = "vision"

# EC2 키페어 이름 (AWS 콘솔 > EC2 > 키 페어에서 미리 생성)
key_name = "your-key-pair-name"

# RDS 비밀번호 (8자 이상, 특수문자 포함 권장)
db_password = "YourSecurePassword123!"

# 필요 시 인스턴스 타입 변경
ec2_instance_type = "t3.small"
db_instance_class = "db.t3.micro"

# EC2 AMI (고정값 - most_recent 자동조회로 인한 예기치 않은 인스턴스 재생성 방지)
# 최초 발급: aws ec2 describe-images --owners amazon --filters "Name=name,Values=al2023-ami-*-x86_64" --query "reverse(sort_by(Images,&CreationDate))[0].ImageId" --output text
# 의도적으로 업그레이드할 때만 이 값을 바꾸세요.
ec2_ami_id = "ami-xxxxxxxxxxxxxxxxx"

# 도메인 (Route53 호스팅 영역으로 네임서버가 위임되어 있어야 함)
domain_name = "api.example.com"
root_domain = "example.com"

# ACM 인증서 ARN (ALB와 같은 리전에서 발급된 것)
acm_certificate_arn = "arn:aws:acm:ap-northeast-2:xxxxxxxxxxxx:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# 카카오 디벨로퍼스 (REST API 키 / Client Secret, JavaScript 키·Admin 키 아님)
kakao_rest_api_key  = "your-kakao-rest-api-key"
kakao_client_secret = "your-kakao-client-secret"
kakao_redirect_uri  = "https://api.example.com/login/oauth2/code/kakao"

# 프론트엔드 주소 (로그인 성공/실패 리다이렉트용) — 실제로 브라우저가 접속하는 도메인과 정확히 일치해야 함
# (예: Vercel에서 www가 Production이고 루트는 www로 리다이렉트한다면 www 쪽 주소)
app_frontend_url = "https://your-frontend.example.com"

# Vercel 등 프론트 호스팅 서비스가 도메인 연결 시 안내하는 DNS 값 (Vercel Domains 화면에서 확인)
vercel_apex_ip          = "000.000.000.000"
vercel_www_cname_target = "xxxxxxxxxxxxxxxx.vercel-dns-xxx.com"

# 서비스 JWT 서명 키 (openssl rand -base64 32 로 생성)
jwt_secret = "REPLACE_WITH_GENERATED_SECRET"

# ──────────────── 사업자등록증 업로드 (DV-112) ────────────────
# 아래 둘은 기본값이 없는 필수 변수다 - 빠뜨리면 apply가 진행되지 않는다.

# 업로드 토큰 HMAC 서명 키 (openssl rand -base64 32 로 생성).
# JWT 서명 키와 반드시 다른 값을 쓴다 - 한쪽이 유출돼도 다른 쪽이 살아남아야 한다.
business_registration_upload_token_secret = "REPLACE_WITH_GENERATED_SECRET"

# OCR Lambda 함수 이름 (별도 레포 biz-eligibility에서 배포한 함수)
business_registration_ocr_function = "biz-eligibility-ocr"

# ⚠️ OCR Lambda 함수 ARN - Lambda를 배포한 뒤 반드시 채우고 다시 apply한다.
# 이 값이 비어 있으면 EC2에 lambda:InvokeFunction 권한이 아예 만들어지지 않는다
# (Lambda 배포 전에도 apply가 되도록 기본값이 ""이다). 함수 이름만 채우고 ARN을 비워두면
# 앱은 매 업로드마다 invoke를 시도하다 AccessDenied로 조용히 실패해, 업로드는 성공하되
# OCR 필드가 전부 null로 내려간다 - 에러는 서버 로그에만 남는다.
business_registration_ocr_function_arn = "arn:aws:lambda:ap-northeast-2:xxxxxxxxxxxx:function:biz-eligibility-ocr"
